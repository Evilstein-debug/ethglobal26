{
  "name": "agentarena",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:reset": "tsx --env-file-if-exists=apps/server/.env scripts/dev-reset.ts",
    "dev:mainnet": "sh -c 'set -ea; . ./apps/server/.env.mainnet; pnpm --parallel --filter @starter/server --filter @starter/web dev'",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present --no-bail lint && eslint scripts",
    "lint:fix": "pnpm -r --if-present --no-bail lint:fix && eslint scripts --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p scripts",
    "codegen": "pnpm --filter @starter/shared codegen",
    "build:contracts": "pnpm --filter @starter/contracts build",
    "deploy:local": "pnpm --filter @starter/contracts deploy:local && pnpm codegen",
    "deploy:base": "pnpm --filter @starter/contracts deploy:base && pnpm codegen",
    "e2e:happy": "LOCAL_ANVIL_PORT=8546 RPC_URL=http://127.0.0.1:8546 PORT=8788 SERVER_URL=http://localhost:8788 tsx --env-file-if-exists=.env scripts/e2e-happy.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "seed:replay": "tsx --env-file-if-exists=.env scripts/seed-replay.ts"
  },
  "devDependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "0.9.0",
    "@eslint/js": "9.39.5",
    "@starter/flash": "workspace:*",
    "@starter/shared": "workspace:*",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "ethers": "^6.17.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "viem": "2.57.14"
  }
}
