# apps/web environment. Copy to apps/web/.env.local (gitignored).
# `pnpm dev` forces the local chain, so nothing here is required locally.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets here.

# Active chain for the app. 31337 = local anvil, 11155111 = Ethereum Sepolia.
# Supported chains live in packages/shared/src/chains.ts.
NEXT_PUBLIC_CHAIN_ID=31337

# Optional RPC override for the active chain. Unset → viem's default public RPC (see VERIFIED.md).
# Public alternatives for Sepolia: https://chainlist.org/chain/11155111
NEXT_PUBLIC_RPC_URL=

# Optional. Without it the app offers injected/browser wallets only (MetaMask, Rabby, ...).
# With it, RainbowKit also offers WalletConnect (mobile wallets, QR code).
# Free project ID: https://dashboard.reown.com (docs: https://docs.reown.com/cloud/relay)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base URL of apps/server.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
