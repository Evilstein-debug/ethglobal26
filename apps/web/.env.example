# apps/web environment. Copy to apps/web/.env.local (gitignored); on Vercel, set these under
# Project → Settings → Environment Variables.
# `pnpm dev` forces the local chain, so nothing here is required locally.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets here.
# World ID needs nothing here: the page reads its public settings from the server.

# Active chain for the app. 31337 = local anvil, 8453 = Base mainnet.
NEXT_PUBLIC_CHAIN_ID=31337

# Optional RPC for the active chain. Unset → viem's default public RPC (see VERIFIED.md).
# WHERE: your RPC provider's dashboard, the Base mainnet HTTPS URL. It's visible to every visitor,
# so use a key restricted to your site's domain, not the server's key.
NEXT_PUBLIC_RPC_URL=

# Optional. Without it the app offers injected/browser wallets only (MetaMask, Rabby, ...).
# WHERE: https://dashboard.reown.com (free), create a project and copy its Project ID.
# Docs: https://docs.reown.com/cloud/relay
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base URL of apps/server.
# WHERE: http://localhost:8787 locally; your Render service URL for the deployed server.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
# 1 = recording mode: hides the simulated-Flash markers and local dev controls (faucet, price buttons).
NEXT_PUBLIC_DEMO_MODE=
