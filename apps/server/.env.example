# apps/server environment. Copy to apps/server/.env (gitignored). NEVER commit real values.
# `pnpm dev` forces CHAIN_ID=31337 and the local RPC, and uses labeled stubs: locally, everything
# below is optional. On Base, MASTER_KEY and OPERATOR_PRIVATE_KEY are required, and Flash, 0G and
# World must be set for trading, decisions and onboarding to work.
# Product decisions: Base mainnet only, Base USDC only (CLAUDE.md).

# ── Chain ────────────────────────────────────────────────────────────────────────────────
# 31337 = local anvil, 8453 = Base mainnet. Supported chains: packages/shared/src/chains.ts
CHAIN_ID=31337
# Optional RPC override. Unset → viem's default public RPC (https://mainnet.base.org on Base,
# rate-limited). Use your own provider's Base endpoint for anything beyond a quick test.
# WHERE: your RPC provider's dashboard, the Base mainnet HTTPS URL.
RPC_URL=

# ── Server ───────────────────────────────────────────────────────────────────────────────
PORT=8787
# Browser origins allowed to call this API, comma-separated.
# WHERE: your Vercel site URL once deployed, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
# Postgres. Production: your Neon pooled connection string, e.g.
#   postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Unset → local in-process PGlite at apps/server/data/pglite-<chainId> (no setup needed).
# WHERE: https://console.neon.tech → your project → Connect button → copy the connection string.
# Pooled is the default there (keep the "Connection pooling" toggle on: the host has "-pooler").
# Docs: https://neon.com/docs/connect/connect-from-any-app
DATABASE_URL=
# Tests only: run server tests on real Postgres instead of PGlite. Must point at localhost, because
# the tests DROP the public schema. WHERE: your own local Postgres.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agentarena_test

# ── Keys ─────────────────────────────────────────────────────────────────────────────────
# 32-byte hex key that encrypts agent private keys (AES-GCM).
# WHERE: you generate it: openssl rand -hex 32
# Losing it makes every agent wallet unrecoverable; leaking it exposes every agent's funds.
MASTER_KEY=
# Operator key: calls Arena operator functions (open entries, lock, resolve, publish rewards)
# and funds the reward pool. On Base use a dedicated wallet holding only what the pool needs.
# WHERE: you generate it: cast wallet new. Then send it Base ETH for gas and USDC for the pool, and
# use its address as OPERATOR_ADDRESS when deploying (packages/contracts/.env.example).
OPERATOR_PRIVATE_KEY=

# ── Definitive Flash ─────────────────────────────────────────────────────────────────────
# Docs: https://flash.definitive.fi/docs · API: https://flash.definitive.fi/v1
# Integrator key.
# WHERE: log in at https://app.definitive.fi → More (top nav) → Flash → Create Flash Key.
# Docs: https://flash.definitive.fi/docs/getting-started
FLASH_API_KEY=
FLASH_API_BASE_URL=https://flash.definitive.fi/v1
# Our integrator fee in bps; sent as the same string on /quote and /order. You choose this.
FLASH_INTEGRATOR_FEE_BPS=0
# Flash contracts on Base, read from a real quote (never guessed). The agent signer refuses
# approvals to any other spender and EIP-712 signatures for any other verifyingContract.
# Comma-separated.
# WHERE: run this once with your key and paste its output (read-only: quotes, no funds move):
#   FLASH_API_KEY=... pnpm tsx scripts/flash-inspect.ts
FLASH_APPROVAL_SPENDERS=
FLASH_TYPED_DATA_CONTRACTS=
# Optional ERC-8021 builder code. WHERE: register on https://base.dev
FLASH_ATTRIBUTION_CODE=
# Hand-written trades for the first live smoke test (default: on for anvil, off on Base).
ALLOW_MANUAL_TRADES=

# ── 0G Private Computer / Compute Router ─────────────────────────────────────────────────
# Docs: https://docs.0g.ai/developer-hub/building-on-0g/compute-network/router/overview
# WHERE: https://pc.0g.ai → connect a wallet → Dashboard → API Keys → Create. The sk- secret is
# shown only once. In the same list, set the key's trust mode to Private.
# Credits: pc.0g.ai → Dashboard → Deposit (0G tokens); ask the 0G team about hackathon credits.
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api.0g.ai/v1
# TeeML models only (sealed inference). WHERE: curl https://router-api.0g.ai/v1/models
ZEROG_MODEL=glm-5.3
# Minimum take-profit distance as a fraction (default 0.008 = 0.8%).
# WHERE: set it above the Flash round-trip fee printed by scripts/flash-inspect.ts, so a
# profitable round is reachable.
TRADE_MIN_TP_PCT=

# ── World ID ─────────────────────────────────────────────────────────────────────────────
# How owners prove they're human: 'world' (IDKit proof, verified here) or 'dev'.
# 'dev' accepts a made-up identity, is the default on local anvil, and is REFUSED on Base.
HUMAN_VERIFIER=
# World ID 4.0. Docs: https://docs.world.org/world-id/idkit/integrate.md
# WHERE: create an app at https://developer.world.org and keep its app_id, rp_id and signing_key.
# Migrating an older app? Click the "Enable World ID 4.0" banner there to get the RP values.
WORLD_APP_ID=
WORLD_RP_ID=
# SECRET: signs proof requests server-side. Never send it to the browser.
WORLD_RP_SIGNING_KEY=
# Action scoping the nullifier: one human = one account for this action. You choose this string;
# changing it lets everyone register again.
WORLD_ACTION=agentarena-owner-v1
# production, or staging to test with the simulator (https://simulator.worldcoin.org).
WORLD_ENVIRONMENT=production

# ── Rounds and rewards (you choose these) ────────────────────────────────────────────────
ROUNDS_ENABLED=true
ROUND_REGISTRATION_MS=180000
ROUND_PREDICTING_MS=240000
ROUND_TRADING_MS=600000
# Pause between rounds (live: e.g. 2580000 for one round per hour with the defaults above).
ROUND_GAP_MS=0
# Reward epoch length and budget (USDC base units: 5000000 = 5 USDC). The budget is also capped
# onchain by Arena.epochCap and by the unallocated pool, which the operator funds.
REWARD_EPOCH_MS=3600000
REWARD_EPOCH_BUDGET=5000000
REWARD_MIN_ENTRIES=1
REWARD_MIN_PREDICTIONS=2
