# apps/server environment. Copy to apps/server/.env (gitignored). NEVER commit real values.
# `pnpm dev` forces CHAIN_ID=31337 and the local RPC; everything marked (Phase N) is unused
# until that phase lands. Product decisions: Base mainnet only, Base USDC only (CLAUDE.md).

# ── Chain ────────────────────────────────────────────────────────────────────────────────
# 31337 = local anvil, 8453 = Base mainnet. Supported chains: packages/shared/src/chains.ts
CHAIN_ID=31337
# Optional RPC override. Unset → viem's default public RPC (https://mainnet.base.org on Base,
# rate-limited). Use your own provider's Base endpoint for anything beyond a quick test.
RPC_URL=

# ── Server ───────────────────────────────────────────────────────────────────────────────
PORT=8787
CORS_ORIGIN=http://localhost:3000
# Postgres. Production: your Neon pooled connection string, e.g.
#   postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Unset → local in-process PGlite at apps/server/data/pglite-<chainId> (no setup needed).
DATABASE_URL=

# ── Keys (Phase 2+) ──────────────────────────────────────────────────────────────────────
# 32-byte hex key that encrypts agent private keys (AES-GCM). Generate: openssl rand -hex 32
# Losing it makes every agent wallet unrecoverable; leaking it exposes every agent's funds.
MASTER_KEY=
# Operator key: calls Arena operator functions (open entries, lock, resolve, publish rewards)
# and funds the reward pool. On Base use a dedicated wallet holding only what the pool needs.
OPERATOR_PRIVATE_KEY=

# ── Definitive Flash (Phase 3) ───────────────────────────────────────────────────────────
# Docs: https://flash.definitive.fi/docs · API: https://flash.definitive.fi/v1
# Integrator key: Definitive app → More → Flash → Create Flash Key
FLASH_API_KEY=
FLASH_API_BASE_URL=https://flash.definitive.fi/v1
# Our integrator fee in bps; sent as the same string on /quote and /order.
FLASH_INTEGRATOR_FEE_BPS=0
# Flash contracts on Base, read from a real quote (never guessed). Run once with your key:
#   FLASH_API_KEY=... pnpm tsx scripts/flash-inspect.ts
# and paste its output here. The agent signer refuses approvals to any other spender and
# EIP-712 signatures for any other verifyingContract. Comma-separated.
FLASH_APPROVAL_SPENDERS=
FLASH_TYPED_DATA_CONTRACTS=
# Optional ERC-8021 builder code registered on base.dev.
FLASH_ATTRIBUTION_CODE=
# Hand-written trades for the first live smoke test (default: on for anvil, off on Base).
ALLOW_MANUAL_TRADES=

# ── 0G Private Computer / Compute Router (Phase 4) ───────────────────────────────────────
# Docs: https://docs.0g.ai/developer-hub/building-on-0g/compute-network/router/overview
# sk- API key from https://pc.0g.ai (Dashboard → API Keys). Set the key's trust mode to Private.
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api.0g.ai/v1
# TeeML models only (sealed inference). List: curl https://router-api.0g.ai/v1/models
ZEROG_MODEL=glm-5.3
# Minimum take-profit distance as a fraction (default 0.008 = 0.8%). Set it above the Flash
# round-trip fee measured by scripts/flash-inspect.ts so a profitable round is reachable.
TRADE_MIN_TP_PCT=

# ── World ID (Phase 6) ───────────────────────────────────────────────────────────────────
# How owners prove they're human: 'world' (IDKit proof, verified here) or 'dev'.
# 'dev' accepts a made-up identity, is the default on local anvil, and is REFUSED on Base.
HUMAN_VERIFIER=
# App ID and action from the World Developer Portal.
WORLD_APP_ID=
WORLD_ACTION=

# ── Rounds and rewards (Phase 5) ─────────────────────────────────────────────────────────
ROUND_REGISTRATION_MS=180000
ROUND_PREDICTING_MS=240000
ROUND_TRADING_MS=600000
# Reward epoch length and budget (USDC base units: 5000000 = 5 USDC).
REWARD_EPOCH_MS=3600000
REWARD_EPOCH_BUDGET=5000000
