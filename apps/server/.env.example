# apps/server environment. Copy to apps/server/.env (gitignored).
# `pnpm dev` forces CHAIN_ID=31337 and the local RPC, so nothing here is required locally.

# Active chain for this app. 31337 = local anvil, 11155111 = Ethereum Sepolia.
# Supported chains live in packages/shared/src/chains.ts.
CHAIN_ID=31337

# Optional RPC override for the active chain. Unset → viem's default public RPC for the chain
# (see VERIFIED.md). For Sepolia, any provider works, e.g. a free key from your provider of
# choice, or a public endpoint listed at https://chainlist.org/chain/11155111
RPC_URL=

# HTTP port for the API.
PORT=8787

# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGIN=http://localhost:3000
