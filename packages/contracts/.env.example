# packages/contracts environment. Copy to packages/contracts/.env (gitignored).
# Forge loads this file automatically. Nothing here is needed for local anvil.

# Base mainnet RPC, used by `--rpc-url base` (foundry.toml [rpc_endpoints]).
BASE_RPC_URL=https://mainnet.base.org

# Explorer API key for `--verify`. Etherscan API V2 uses one key for all chains, Base included.
# Free key: https://etherscan.io/myapikey (docs: https://docs.etherscan.io/)
ETHERSCAN_API_KEY=

# Deployer: do NOT put a private key here. Import the deployer key into Foundry's encrypted
# keystore once, then deploy with --account:
#   cast wallet import deployer --interactive
# Docs: https://getfoundry.sh/cast/reference/wallet
# DEPLOYER_ACCOUNT=deployer
