# packages/contracts environment. Copy to packages/contracts/.env (gitignored).
# Forge loads this file automatically. Nothing here is needed for local anvil.

# Sepolia RPC, used by `--rpc-url sepolia` (see foundry.toml [rpc_endpoints]).
# Any provider works. Public endpoints: https://chainlist.org/chain/11155111
SEPOLIA_RPC_URL=

# Optional: also used by the fork test (`FORK_RPC_URL=$SEPOLIA_RPC_URL forge test`).
FORK_RPC_URL=

# Explorer API key for `--verify`. Etherscan API V2 uses one key for all supported chains.
# Free key: https://etherscan.io/myapikey (docs: https://docs.etherscan.io/)
ETHERSCAN_API_KEY=

# Deployer: do NOT put a private key here. Import a throwaway testnet key into Foundry's
# encrypted keystore once, then deploy with --account:
#   cast wallet import deployer --interactive
# Docs: https://getfoundry.sh/cast/reference/wallet
# DEPLOYER_ACCOUNT=deployer
