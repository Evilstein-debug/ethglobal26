# packages/contracts environment. Copy to packages/contracts/.env (gitignored).
# Forge loads this file automatically. Nothing here is needed for local anvil.

# Base mainnet RPC, used by `--rpc-url base` (foundry.toml [rpc_endpoints]).
# WHERE: https://mainnet.base.org works for a deploy, or use your RPC provider's Base mainnet URL.
BASE_RPC_URL=https://mainnet.base.org

# Explorer API key for `--verify`. Etherscan API V2 uses one key for all chains, Base included.
# WHERE: register at https://etherscan.io/register, then https://etherscan.io/apidashboard → Add.
# Docs: https://docs.etherscan.io/set-up-your-api-key
ETHERSCAN_API_KEY=

# Deployer: do NOT put a private key here. Import the deployer key into Foundry's encrypted
# keystore once, then deploy with --account:
#   cast wallet import deployer --interactive
# Docs: https://getfoundry.sh/cast/reference/wallet
# DEPLOYER_ACCOUNT=deployer

# Base deploy settings, read by script/Deploy.s.sol. Uncomment to set: left empty they may not
# fall back to their defaults.
# Required off anvil. WHERE: Circle's USDC on Base, see VERIFIED.md.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Server wallet that opens, locks, resolves and publishes. Default: the deployer, so set this
# whenever the server's operator key is a different wallet.
# WHERE: the address of the server's OPERATOR_PRIVATE_KEY:
#   cast wallet address --private-key <key>
# OPERATOR_ADDRESS=
# Admin of Arena (Ownable2Step). Default: the deployer. WHERE: a wallet your team controls.
# ARENA_OWNER=
# Max USDC per reward epoch, in base units. Default 5000000 (5 USDC). You choose this.
# EPOCH_CAP=
