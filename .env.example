# Root environment for `pnpm e2e:happy`. Copy to .env (gitignored).
# Local anvil needs NOTHING here. App settings live in apps/web/.env.example,
# apps/server/.env.example and packages/contracts/.env.example.

# Chain to test against. 31337 = local anvil, 11155111 = Ethereum Sepolia.
CHAIN_ID=31337

# Optional RPC override. Unset → viem's default public RPC (see VERIFIED.md).
# Sepolia endpoints: https://chainlist.org/chain/11155111
RPC_URL=

# apps/server base URL; the test checks its feed.
SERVER_URL=http://localhost:8787

# Testnet only: payer key. Use a THROWAWAY key made for this hackathon and funded from a faucet;
# never a key that holds real funds. Never commit .env.
#   Generate: cast wallet new   (https://getfoundry.sh/cast/reference/wallet)
#   Faucets:  https://ethereum.org/developers/docs/networks/#sepolia
E2E_PRIVATE_KEY=
