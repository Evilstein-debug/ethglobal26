# Root environment for `pnpm e2e:happy` and `pnpm verify`. Copy to .env (gitignored).
# Local anvil needs NOTHING here. App settings live in apps/web/.env.example,
# apps/server/.env.example and packages/contracts/.env.example.

# Chain to test against. e2e runs on 31337 (local anvil) only; 8453 = Base mainnet.
CHAIN_ID=31337

# Optional RPC for the chain above. Unset → viem's default public RPC (see VERIFIED.md).
# WHERE: your RPC provider's dashboard, the Base mainnet HTTPS URL. Same value as the server's.
RPC_URL=

# apps/server base URL.
# WHERE: http://localhost:8787 locally; your Render service URL for the deployed server.
SERVER_URL=http://localhost:8787

# 0G chain RPC for `pnpm verify` TEE checks. Unset → https://evmrpc.0g.ai (public, no key needed).
ZG_RPC_URL=
